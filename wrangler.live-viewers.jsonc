{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freedomfromdiabetes-live-viewers",
  "main": "workers/live-viewers.ts",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_VIEWERS",
        "class_name": "LiveViewerRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveViewerRoom"]
    }
  ]
}
