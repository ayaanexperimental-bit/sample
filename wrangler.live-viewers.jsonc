{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ywcoach-live-viewers",
  "main": "workers/live-viewers.ts",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 2 * * *"]
  },
  "d1_databases": [
    {
      "binding": "ADMIN_DB",
      "database_name": "ywcoach-admin",
      "database_id": "a82c8785-b313-4c30-ac94-6bd9efa33712"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_VIEWERS",
        "class_name": "LiveViewerRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveViewerRoom"]
    }
  ]
}
