{
  "name": "pcos-wellness-landing-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-static.mjs",
    "deploy": "pnpm deploy:live-viewers && pnpm deploy:pages",
    "deploy:live-viewers": "wrangler deploy --config wrangler.live-viewers.jsonc",
    "deploy:pages": "pnpm build:pages && wrangler pages deploy out --project-name freedomfromdiabetes --branch main",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@next/env": "latest",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "maath": "^0.10.8",
    "motion": "^12.38.0",
    "next": "latest",
    "ogl": "^1.0.11",
    "radix-ui": "^1.4.3",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260506.1",
    "@opennextjs/cloudflare": "^1.19.6",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.184.0",
    "esbuild": "^0.28.0",
    "eslint": "9.39.1",
    "eslint-config-next": "latest",
    "playwright": "^1.59.1",
    "prettier": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.10"
    }
  }
}
