{
  "name": "pcos-wellness-landing-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-static.mjs",
    "deploy": "pnpm deploy:live-viewers && pnpm deploy:pages",
    "deploy:live-viewers": "wrangler deploy --config wrangler.live-viewers.jsonc",
    "deploy:pages": "pnpm build:pages && wrangler pages deploy out --project-name freedomfromdiabetes --branch main",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-production-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.2.6",
    "ogl": "1.0.11",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260506.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "wrangler": "4.87.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.10"
    }
  }
}
