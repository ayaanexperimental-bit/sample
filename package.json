{
  "name": "pcos-wellness-landing-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-static.mjs",
    "deploy": "pnpm deploy:live-viewers && pnpm deploy:pages",
    "deploy:live-viewers": "wrangler deploy --config wrangler.live-viewers.jsonc",
    "deploy:pages": "pnpm build:pages && wrangler pages deploy out --project-name freedomfromdiabetes --branch main",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "latest",
    "ogl": "^1.0.11",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260506.1",
    "@opennextjs/cloudflare": "^1.19.6",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.1",
    "eslint-config-next": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.10"
    }
  }
}
