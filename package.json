{
  "name": "yw-coach-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-static.mjs",
    "build:pages-functions": "node scripts/build-pages-functions.mjs",
    "deploy": "pnpm deploy:live-viewers && pnpm deploy:pages",
    "deploy:live-viewers": "wrangler deploy --config wrangler.live-viewers.jsonc",
    "deploy:pages": "pnpm build:pages && pnpm build:pages-functions && wrangler pages deploy out --project-name ywcoach --branch main --no-bundle",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-production-links.mjs",
    "test:admin-security": "playwright test --config=playwright.admin-security.config.ts",
    "validate:coach-skins": "playwright test --config=playwright.admin-security.config.ts --grep \"template skin registry gates\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@bunnio/rembg-web": "1.0.2",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.184.1",
    "leaflet": "^1.9.4",
    "next": "16.2.6",
    "ogl": "1.0.11",
    "onnxruntime-web": "1.23.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260630.1",
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "wrangler": "4.106.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "minimatch@10>brace-expansion": "5.0.6",
      "postcss": "8.5.10",
      "ws": "8.20.1"
    }
  }
}
