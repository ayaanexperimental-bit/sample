# Site
NEXT_PUBLIC_SITE_URL=https://ywcoach.com
NEXT_PUBLIC_SUPPORT_NAME=Yours Wellness Support
NEXT_PUBLIC_SUPPORT_EMAIL=support@ywcoach.com
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_MESSAGE=We could not complete this step. Please contact support for help.

# Server-only funnel/payment redirect secrets.
# Keep these server-only. Never use NEXT_PUBLIC_ for secrets.
FUNNEL_ACCESS_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PAYMENT_PAGE_URL=https://pages.razorpay.com/pl_SkURMJD4JJjdxO/view
SUCCESS_ACCESS_SECRET=

# Server-only admin auth placeholders.
# Keep these server-only. Never use NEXT_PUBLIC_ for admin secrets.
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_SESSION_SECRET=
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_REDIRECT_URI=https://ywcoach.com/api/admin/auth/google/callback
ADMIN_OAUTH_STATE_SECRET=
ADMIN_REQUIRE_DB_ADMIN_ROLES=false
ADMIN_EMAIL_OTP_ENABLED=true
ADMIN_EMAIL_OTP_FROM=admin@ywcoach.com
ADMIN_EMAIL_OTP_FROM_NAME=YW Coach Admin
ADMIN_OTP_TTL_SECONDS=600
ADMIN_OTP_MAX_ATTEMPTS=5
RESEND_API_KEY=

# Server-only AI copy generation for coach referral sites.
# Keep the API key server-side. Never expose it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Server-only backup integration for the later backup/cleanup phase.
GOOGLE_SHEETS_BACKUP_CREDENTIALS_JSON=
GOOGLE_SHEETS_BACKUP_SPREADSHEET_ID=

# Cloudflare bindings used by the real coach-site builder:
# ADMIN_DB stores coach records and media metadata.
# COACH_MEDIA_BUCKET stores uploaded coach photos/videos after R2 is enabled in Cloudflare.

# Server-only private coach/funnel links.
# Do not store private WhatsApp links as Cloudflare secrets/vars.
# Save them in Admin -> Paid Masterclass Links/Settings -> Manage -> Save Server Link.
# Values are stored in the ADMIN_DB private_funnel_links table.
