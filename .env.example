# Site
NEXT_PUBLIC_SITE_URL=https://ywcoach.com
NEXT_PUBLIC_PAYMENT_ENABLED=false

# Server-only funnel/payment redirect secrets.
# Keep these server-only. Never use NEXT_PUBLIC_ for secrets.
FUNNEL_ACCESS_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PAYMENT_PAGE_URL=https://pages.razorpay.com/pl_SkURMJD4JJjdxO/view
SUCCESS_ACCESS_SECRET=

# Server-only admin auth placeholders.
# Keep these server-only. Never use NEXT_PUBLIC_ for admin secrets.
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_SESSION_SECRET=
ADMIN_AUTH_DEMO_ENABLED=false
ADMIN_DEV_OTP=
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_REDIRECT_URI=https://ywcoach.com/api/admin/auth/google/callback
ADMIN_OAUTH_STATE_SECRET=
ADMIN_REQUIRE_DB_ADMIN_ROLES=false
ADMIN_EMAIL_OTP_ENABLED=true
ADMIN_EMAIL_OTP_FROM=admin@ywcoach.com
ADMIN_EMAIL_OTP_FROM_NAME=YW Coach Admin
ADMIN_OTP_TTL_SECONDS=600
ADMIN_OTP_MAX_ATTEMPTS=5
RESEND_API_KEY=

# Server-only private coach/funnel links.
# Keep actual private group links in Cloudflare secrets/vars, never in source.
WHATSAPP_GROUP_URL_GYANA_PCOS_51=
# Optional scalable JSON map:
# YW_PRIVATE_FUNNEL_LINKS_JSON={"gyana-pcos-51":{"whatsappGroupUrl":"https://chat.whatsapp.com/..."}}

# Internal tools
ENABLE_PROMPT_LAB=false
