# Site
NEXT_PUBLIC_SITE_URL=https://ywcoach.com
NEXT_PUBLIC_SUPPORT_NAME=Yours Wellness Support
NEXT_PUBLIC_SUPPORT_EMAIL=support@ywcoach.com
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_MESSAGE=We could not complete this step. Please contact support for help.

# Server-only funnel/payment redirect secrets.
# Keep these server-only. Never use NEXT_PUBLIC_ for secrets.
FUNNEL_ACCESS_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PAYMENT_PAGE_URL=https://pages.razorpay.com/pl_SkURMJD4JJjdxO/view
SUCCESS_ACCESS_SECRET=

# Server-only public Shop Website Builder payment settings.
# SHOP_PAYMENT_PAGE_URL is an optional fallback only; Admin Panel -> Shop remains the editable source.
# SHOP_RAZORPAY_WEBHOOK_SECRET is required for real server-side Shop payment verification/publishing.
SHOP_PAYMENT_PAGE_URL=
SHOP_RAZORPAY_WEBHOOK_SECRET=

# Server-only admin auth configuration.
# Keep these server-only. Never use NEXT_PUBLIC_ for admin secrets.
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_SESSION_SECRET=
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_REDIRECT_URI=https://ywcoach.com/api/admin/auth/google/callback
ADMIN_OAUTH_STATE_SECRET=
ADMIN_REQUIRE_DB_ADMIN_ROLES=false
ADMIN_EMAIL_OTP_ENABLED=true
ADMIN_EMAIL_OTP_FROM=admin@ywcoach.com
ADMIN_EMAIL_OTP_FROM_NAME=YW Coach Admin
ADMIN_OTP_TTL_SECONDS=600
ADMIN_OTP_MAX_ATTEMPTS=5
RESEND_API_KEY=

# Admin V2 integration flags.
# Admin V2 stays disabled by default until explicitly enabled for local/staging review.
# Use NEXT_PUBLIC_ mirrors only for local/staging client-side preview.
ENABLE_ADMIN_V2=false
NEXT_PUBLIC_ENABLE_ADMIN_V2=false
ENABLE_ADMIN_V2_ADVANCED_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ADMIN_V2_ADVANCED_ANALYTICS=false
ENABLE_ADMIN_V2_REVENUE_WIDGETS=false
NEXT_PUBLIC_ENABLE_ADMIN_V2_REVENUE_WIDGETS=false
ENABLE_ADMIN_V2_QUICK_ACTIONS=false
NEXT_PUBLIC_ENABLE_ADMIN_V2_QUICK_ACTIONS=false
ENABLE_ADMIN_V2_AI_INSIGHTS=false
NEXT_PUBLIC_ENABLE_ADMIN_V2_AI_INSIGHTS=false
ENABLE_ADMIN_V2_SUPPORT_DEFAULTS=false
NEXT_PUBLIC_ENABLE_ADMIN_V2_SUPPORT_DEFAULTS=false
ENABLE_ADMIN_V2_EXPERIMENTAL_CHARTS=false
NEXT_PUBLIC_ENABLE_ADMIN_V2_EXPERIMENTAL_CHARTS=false

# Admin AI Copilot operating-layer flags. Read-only/global analysis is on by
# default; sensitive mutation, voice, and scheduled jobs stay off.
ENABLE_ADMIN_AI_COPILOT=true
NEXT_PUBLIC_ENABLE_ADMIN_AI_COPILOT=true
ENABLE_ADMIN_AI_GLOBAL_MODE=true
NEXT_PUBLIC_ENABLE_ADMIN_AI_GLOBAL_MODE=true
ENABLE_ADMIN_AI_PROACTIVE_ALERTS=true
NEXT_PUBLIC_ENABLE_ADMIN_AI_PROACTIVE_ALERTS=true
ENABLE_ADMIN_AI_ACTIONS=true
NEXT_PUBLIC_ENABLE_ADMIN_AI_ACTIONS=true
ENABLE_ADMIN_AI_SENSITIVE_ACTIONS=false
NEXT_PUBLIC_ENABLE_ADMIN_AI_SENSITIVE_ACTIONS=false
ENABLE_ADMIN_AI_VOICE=false
NEXT_PUBLIC_ENABLE_ADMIN_AI_VOICE=false
ENABLE_ADMIN_AI_MEMORY=true
NEXT_PUBLIC_ENABLE_ADMIN_AI_MEMORY=true
ENABLE_ADMIN_AI_INCIDENT_MODE=true
NEXT_PUBLIC_ENABLE_ADMIN_AI_INCIDENT_MODE=true
ENABLE_ADMIN_AI_SCHEDULED_BRIEFINGS=false
NEXT_PUBLIC_ENABLE_ADMIN_AI_SCHEDULED_BRIEFINGS=false

# Server-only AI copy generation for coach referral sites.
# Keep the API key server-side. Never expose it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Server-only coach-photo cutout pipeline. Photoroom is tried first in auto mode,
# remove.bg is the provider fallback, and the validated browser cutout is last.
# Leave both keys empty to keep the original photo in the premium framed fallback.
PHOTOROOM_API_KEY=
REMOVEBG_API_KEY=
IMAGE_BG_REMOVAL_PROVIDER=auto
IMAGE_BG_REMOVAL_ENABLED=true
IMAGE_BG_REMOVAL_QUALITY_THRESHOLD=high

# Server-only backup integration for the later backup/cleanup phase.
GOOGLE_SHEETS_BACKUP_CREDENTIALS_JSON=
GOOGLE_SHEETS_BACKUP_SPREADSHEET_ID=

# Cloudflare bindings used by the real coach-site builder:
# ADMIN_DB stores coach records and media metadata.
# COACH_MEDIA_BUCKET stores uploaded coach photos/videos after R2 is enabled in Cloudflare.

# Server-only private coach/funnel links.
# Do not store private WhatsApp links as Cloudflare secrets/vars.
# Save them in Admin -> Paid Masterclass Links/Settings -> Manage -> Save Server Link.
# Values are stored in the ADMIN_DB private_funnel_links table.
